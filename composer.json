{
  "name": "eureka/component-database",
  "description": "PHP database library.",
  "type": "library",
  "minimum-stability": "stable",
  "license": "MIT",

  "authors": [
    {
      "name": "Romain Cottard",
      "role": "Developer"
    }

  ],

  "autoload": {
    "psr-4": {
      "Eureka\\Component\\Database\\": "./src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Eureka\\Component\\Database\\Tests\\Unit\\": "./tests/unit",
      "Eureka\\Component\\Database\\Tests\\Integration\\": "./tests/integration"
    }
  },

  "require": {
    "php": ">=8.3",
    "ext-pdo": "*"
  },

  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.92.3",
    "phpstan/phpstan": "^2.1.33",
    "phpstan/phpstan-phpunit": "^2.0.11",
    "phpunit/phpcov": "^11.0.3",
    "phpunit/phpunit": "^12.5.4",
    "shipmonk/composer-dependency-analyser": "^1.8.4"
  }
}
